# Copy to .env for Docker Compose. Never commit real tokens or vault contents.
# Compose publishes only the sync server; terminate HTTPS with your own reverse proxy.
OMP_SYNC_PUBLISH_HOST=127.0.0.1
OMP_SYNC_PUBLISH_PORT=8787

# Optional complete image references for published-image deployments (defaults shown).
# OMP_SYNC_IMAGE=ghcr.io/brentdevs/omp-sync-server:latest
# OMP_SYNC_BROKER_IMAGE=ghcr.io/brentdevs/omp-sync-server-broker:latest
# Set BOTH refs to matching published sha-<full-commit> or release tags to select
# the same source revision. Pin each image's @sha256:... digest for immutable bytes.
# Public GHCR packages need no login. Private packages require docker login ghcr.io
# with a token granting read:packages and access to both packages.
# Published images: docker compose -f docker-compose.yml -f docker-compose.images.yml up -d --no-build --pull always --wait
# Local source build: docker compose up --build --wait

# Native/Bun/Nix settings (export these in your shell or service environment).
# Compose sets the container equivalents explicitly and persists named volumes.
# OMP_SYNC_DATA_DIR=.data
# OMP_SYNC_HOST=127.0.0.1
# OMP_SYNC_PORT=8787

# Native deployment: connect to the real OMP auth-broker with its local bearer token.
# Choose exactly one of TOKEN or TOKEN_FILE; neither is needed for sync-only use.
# OMP_SYNC_BROKER_URL=http://127.0.0.1:8765
# OMP_SYNC_BROKER_TOKEN_FILE=/home/you/.omp/auth-broker.token
# OMP_SYNC_BROKER_TOKEN=replace-with-the-real-broker-token

# Compose broker identity: bun user (uid/gid 1000), HOME=/tokens,
# PI_CONFIG_DIR=.omp, PI_CODING_AGENT_DIR=/data/.omp/agent.
# The durable vault stays /data/.omp/agent/agent.db in private broker-data.
# Broker creates /tokens/.omp/auth-broker.token (0600) in broker-token; sync
# mounts ONLY broker-token read-only at /broker-token, reading
# /broker-token/.omp/auth-broker.token. It cannot access the credential vault.
# Broker health gates sync startup, so the token file exists before sync reads it.
# Do not publish broker port 8765, mount these volumes into untrusted containers,
# or treat sync profiles as separate broker-vault trust boundaries.
